. /lib/upgrade/platform.sh

do_set_root_part() {
	if [ "$BCM27XX_SET_ROOT_PART" -eq "1" ]; then
		bcm27xx_set_root_part
		sync
		umount /boot 2>/dev/null || true
		unset BCM27XX_SET_ROOT_PART
	fi
}

[ "$INITRAMFS" = "1" ] || boot_hook_add preinit_main do_set_root_part
