config wifi-device 'radio0'
	option type 'mac80211'
	option path 'platform/soc/fe300000.mmcnr/mmc_host/mmc1/mmc1:0001/mmc1:0001:1'
	option band '2g'
	option channel 'auto'
	option htmode 'NOHT'
	option disabled '0'

config wifi-iface 'sta'
	option device 'radio0'
	option mode 'sta'
	option network 'wifi'
	option encryption 'sae-mixed'
	option disabled '1'
