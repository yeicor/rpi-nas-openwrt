#!/bin/sh /etc/rc.common
# Tailscale Auto-Join Procd Service
# Starts after tailscale daemon (START=80) to automatically join network using one-time auth key

START=85
STOP=10
USE_PROCD=1

start_service() {
    [ ! -f /etc/tailscale_auth_key ] && return 0
    [ ! -s /etc/tailscale_auth_key ] && { rm -f /etc/tailscale_auth_key; return 0; }

    procd_open_instance
    procd_set_param command /usr/bin/tailscale-autojoin
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    return 0
}
