# ==============================================================================
# OpenWrt Headless NAS Configuration (.env)
# Copy this file to .env and adjust variables as desired.
# ==============================================================================

# Target OpenWrt release and hardware target/profile
OPENWRT_VERSION=25.12.5
OPENWRT_TARGET=bcm27xx/bcm2711
OPENWRT_PROFILE=rpi-4

# Hostname of the NAS device
DEVICE_HOSTNAME=rpi4nas

# Non-root user with sudo access and WebDAV login (files on storage will belong to this user)
NAS_USER=nasuser
NAS_PASSWORD=supersecretpassword
# Root password (avoids default empty root password; defaults to NAS_PASSWORD if empty)
ROOT_PASSWORD=supersecretpassword

# SSH public key for root and $NAS_USER (file path like ~/.ssh/id_ed25519.pub or literal "ssh-ed25519 AAAA...")
SSH_PUBLIC_KEY=~/.ssh/id_ed25519.pub

# Tailscale Auth Key (optional - provides zero-touch auto-connect on first boot)
# Generate from https://login.tailscale.com/admin/settings/keys
TAILSCALE_AUTH_KEY=

# Cloudflare Dynamic DNS (active if DDNS_DOMAIN is not empty)
# If DDNS_DOMAIN is specified, DDNS_TOKEN is mandatory.
DDNS_DOMAIN=
DDNS_TOKEN=

# Let's Encrypt / ACME via DNS-01 (active if ACME_DOMAIN is not empty)
# If ACME_DOMAIN is specified, ACME_EMAIL and ACME_CREDENTIALS are mandatory.
ACME_EMAIL=admin@example.com
ACME_DOMAIN=
ACME_DNS_PROVIDER=dns_cloudflare
# Example: CF_Token="your_cloudflare_token_with_zone_dns_edit_permissions"
ACME_CREDENTIALS=
ACME_STAGING=0

# WiFi Fallback Auto-Connection (optional, up to 2 saved networks)
# Automatically connects if Ethernet is disconnected or unavailable.
# Supports WPA2, WPA3, and mixed networks (leave password empty for open networks).
WIFI_SSID_1=
WIFI_PASSWORD_1=

WIFI_SSID_2=
WIFI_PASSWORD_2=

